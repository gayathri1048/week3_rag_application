# --- LLM provider -----------------------------------------------------------
# Options: 'openai' (Groq/OpenRouter/OpenAI URL), 'ollama' (local), 'anthropic' (Claude), 'fallback'
LLM_PROVIDER=openai

# --- OpenAI-Compatible Cloud Endpoint (Groq / OpenRouter / OpenAI / vLLM) ---
# Free ultra-fast Groq API (zero download): https://console.groq.com/keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=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
OPENAI_MODEL=openai/gpt-oss-120b

# --- Ollama (local, free) ---------------------------------------------------
# Install: https://ollama.com/download  then: ollama pull llama3.2
# For vision screenshot reading: ollama pull llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Anthropic --------------------------------------------------------------
# Only needed when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
# (Or run `ant auth login` and leave this unset — the SDK picks up the profile.)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=16000

# --- Retrieval --------------------------------------------------------------
# Embeddings are always local (all-MiniLM-L6-v2) regardless of LLM_PROVIDER.
# The store holds three collections; only the two article ones are populated:
#   support_articles_table_aware  28 chunks — keeps markdown tables intact
#   support_articles_paragraph    28 chunks — plain paragraph chunker
#   support_tickets                0 chunks — legacy, never ingested
CHROMA_PATH=./chroma_db
COLLECTION_NAME=support_articles_table_aware
TOP_K=6
MIN_RELEVANCE=0.25            # 0..1 — drop chunks below this similarity

# --- Ingestion --------------------------------------------------------------
DOCUMENTS_DIR=./documents
CHUNK_SIZE=900                # characters
CHUNK_OVERLAP=150

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- Langfuse Observability -------------------------------------------------
LANGFUSE_SECRET_KEY=sk-lf-0610f22e-2e53-4c7c-a78c-badb24a56da4
LANGFUSE_PUBLIC_KEY=pk-lf-5d5e112d-9820-4cd8-8959-4e478e56a33d
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true

