# --- LLM provider -----------------------------------------------------------
# Which backend generates answers for /api/chat, /api/triage, /api/draft-reply.
#   openai    — Groq, OpenRouter, Together, OpenAI cloud endpoint (fast, zero local download).
#   ollama    — a local model. Free, offline, no key. Requires a running Ollama.
#   anthropic — Claude. Best grounding + citation fidelity; needs a credential.
#   fallback  — no model at all; deterministic templates over retrieved chunks.
# A provider that turns out to be unreachable degrades instead of erroring.
# GET /api/health reports which one is actually serving requests.
LLM_PROVIDER=openai

# --- OpenAI-Compatible Cloud Endpoints (Groq / OpenRouter / OpenAI) ---------
# Free ultra-fast Groq API (zero download): https://console.groq.com/keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.2-11b-vision-preview

# --- Ollama (local, free) ---------------------------------------------------
# Install: https://ollama.com/download  then: ollama pull llama3.2
# For vision screenshot reading: ollama pull llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Anthropic --------------------------------------------------------------
# Only needed when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
# (Or run `ant auth login` and leave this unset — the SDK picks up the profile.)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=16000

# --- Retrieval --------------------------------------------------------------
# Embeddings are always local (all-MiniLM-L6-v2) regardless of LLM_PROVIDER.
CHROMA_PATH=./chroma_db
COLLECTION_NAME=support_articles_paragraph
TOP_K=6
MIN_RELEVANCE=0.25            # 0..1 — drop chunks below this similarity

# --- Ingestion --------------------------------------------------------------
DOCUMENTS_DIR=./documents
CHUNK_SIZE=900                # characters
CHUNK_OVERLAP=150

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- Langfuse Observability -------------------------------------------------
# Get your API keys at https://cloud.langfuse.com (or self-hosted instance)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

